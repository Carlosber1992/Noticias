{
  "expo": {
    "name": "Yasupo",
    "slug": "yasupo",
    "scheme": "yasupo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.yasupo.app",
      "supportsTablet": true
    },
    "android": {
      "package": "com.yasupo.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFFFF"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "asyncRoutes": false
        }
      ],
      "expo-font",
      "expo-video",
      "expo-audio",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yasupo usa tu ubicación para mostrarte lo que hay cerca."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Yasupo usa tus fotos y videos para que los compartas.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ]
  }
}